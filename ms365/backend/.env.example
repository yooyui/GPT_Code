# ============================================
# MS365 管理系统后端 - 环境变量配置模板
# ============================================

# --------------------------------------------
# 服务器配置
# --------------------------------------------
PORT=3000
HOST=localhost

# --------------------------------------------
# 数据库配置
# --------------------------------------------
DB_PATH=./data/db.sqlite

# --------------------------------------------
# 备份配置
# --------------------------------------------
BACKUP_ENABLED=false
BACKUP_PATH=./data/backups
# 备份间隔（毫秒） - 默认 1 小时
BACKUP_INTERVAL=3600000

# --------------------------------------------
# Azure AD 配置
# --------------------------------------------
# 从 Azure Portal 获取这些值：
# 1. 访问 https://portal.azure.com
# 2. 进入 "Azure Active Directory" -> "应用注册"
# 3. 选择你的应用程序

# 租户 ID（目录 ID）
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 应用程序 ID（客户端 ID）
AZURE_CLIENT_ID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# 客户端密钥（从 "证书和密码" 页面创建）
AZURE_CLIENT_SECRET=your-client-secret-value-here

# --------------------------------------------
# Microsoft Graph API 配置
# --------------------------------------------
# Graph API 端点（通常不需要修改）
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# Graph API 授权范围（通常不需要修改）
GRAPH_API_SCOPE=https://graph.microsoft.com/.default

# --------------------------------------------
# 应用模式
# --------------------------------------------
# development - 使用本地 SQLite 数据库（用于开发和测试）
# production  - 使用 Microsoft Graph API（连接到真实的 MS365）
APP_MODE=production
